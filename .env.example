# Root Environment Template

# Backend Configuration
PORT=8000
DATABASE_URL=sqlite:///./sql_app.db
SECRET_KEY=super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=System Administrator

# LLM Provider Configuration (Optional: Gemini / OpenAI API key)
# If left empty, system uses vector retrieval + local grounded context synthesizer
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
